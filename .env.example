# SonaLife — copy this file to `.env` in the same folder and fill in values.
# Restart Metro after changes: npx expo start -c
#
# Supabase: Dashboard → Project Settings → API
#   - Project URL  → EXPO_PUBLIC_SUPABASE_URL
#   - anon public  → EXPO_PUBLIC_SUPABASE_ANON_KEY

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Nutrition — FatSecret Platform API (OAuth2 client credentials; allowlist IPs in FatSecret developer console)
EXPO_PUBLIC_FATSECRET_CLIENT_ID=
EXPO_PUBLIC_FATSECRET_CLIENT_SECRET=
# Optional space-delimited scopes (e.g. basic barcode nlp). Leave unset to request all scopes your app is allowed.
# EXPO_PUBLIC_FATSECRET_TOKEN_SCOPE=
EXPO_PUBLIC_USDA_API_KEY=your_usda_api_key

# EAS / Expo Push (optional but recommended for physical device push tokens)
# eas init → copy projectId, or from https://expo.dev/accounts/<acct>/projects/<slug>
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional (later features)
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_REVENUECAT_KEY=
EXPO_PUBLIC_OURA_CLIENT_ID=
EXPO_PUBLIC_WHOOP_CLIENT_ID=
EXPO_PUBLIC_FITBIT_CLIENT_ID=
EXPO_PUBLIC_THORNE_API_KEY=
EXPO_PUBLIC_CLINIC_SLUG=sona

# Dev: show the daily greeting modal on every dashboard open (ignores last-shown date; use npx expo start -c after changing)
# EXPO_PUBLIC_FORCE_DAILY_GREETING=1
